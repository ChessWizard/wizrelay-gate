# wizrelay-gate — server configuration.
# Copy to .env for local development; set these as environment variables in production.

# Postgres. The compose file provisions one; point this at your own in production.
DATABASE_URL="postgresql://wizrelay:wizrelay@localhost:5432/wizrelay_gate?schema=public"

# Signs session cookies and encrypts stored third-party tokens.
# Generate with: openssl rand -base64 48
AUTH_SECRET=""

# The first owner. Created on first boot when no user exists, then ignored.
OWNER_EMAIL=""
OWNER_NAME=""
OWNER_PASSWORD=""

# Where the server keeps hub clones, gate logs and uploads.
# The container sets this to /data; locally it can be any writable path.
WIZRELAY_GATE_HOME="/data"

# Branding. Every team that installs this can set its own without touching the code.
PANEL_DESCRIPTION=
PANEL_NAME="wizrelay-gate"
PANEL_LOGO_URL=""
PANEL_FAVICON_URL=""
PANEL_ACCENT=""

# Optional shared integrations. A person may connect their own instead.
CLICKUP_API_TOKEN=""
GITHUB_TOKEN=""

# Where gates run.
#   auto  (default) the machine of whoever pressed the button, if one is paired and
#         online; otherwise this one. The single-machine install needs nothing set.
#   agent never this machine. Set this on a panel the team shares: it has none of the
#         checkouts and none of anybody's credentials, and a missing agent should say so
#         instead of quietly running somebody else's gate here.
#   local never an agent.
WIZRELAY_GATE_EXECUTION=auto

# The URL agents dial, when it is not the one the browser happens to be using.
WIZRELAY_GATE_URL=
