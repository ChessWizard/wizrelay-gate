{
  "name": "wizrelay-gate",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "A self-hosted panel that runs wizrelay task quality gates for a team.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:nav": "node scripts/docs-nav.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "agent": "node public/wizrelay-agent.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "clsx": "2.1.1",
    "driver.js": "^1.3.6",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swr": "2.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.21.0",
    "eslint-config-next": "16.4.5",
    "prisma": "^6.19.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "bin": {
    "wizrelay-agent": "public/wizrelay-agent.mjs"
  },
  "files": [
    "public",
    "src",
    "prisma"
  ]
}
